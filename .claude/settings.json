  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -x \"$CLAUDE_PROJECT_DIR/.agents/closed-loop/marks.sh\" && \"$CLAUDE_PROJECT_DIR/.agents/closed-loop/marks.sh\" --hook session-start || true"
          },
          {
            "type": "command",
            "command": "test -x \"$CLAUDE_PROJECT_DIR/.agents/closed-loop/send.sh\" && \"$CLAUDE_PROJECT_DIR/.agents/closed-loop/send.sh\" --hook || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -x \"$CLAUDE_PROJECT_DIR/.agents/closed-loop/marks.sh\" && \"$CLAUDE_PROJECT_DIR/.agents/closed-loop/marks.sh\" --hook pre-compact || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -x \"$CLAUDE_PROJECT_DIR/.agents/closed-loop/marks.sh\" && \"$CLAUDE_PROJECT_DIR/.agents/closed-loop/marks.sh\" --hook session-end || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "test -x \"$CLAUDE_PROJECT_DIR/.agents/purity-sweep/purity-swept.sh\" && \"$CLAUDE_PROJECT_DIR/.agents/purity-sweep/purity-swept.sh\" --hook || true"
          },
          {
            "type": "command",
            "command": "test -x \"$CLAUDE_PROJECT_DIR/.agents/doc-router/route.sh\" && \"$CLAUDE_PROJECT_DIR/.agents/doc-router/route.sh\" --hook || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"$CLAUDE_PROJECT_DIR/scripts/command-guard/index.ts\" && node --no-warnings \"$CLAUDE_PROJECT_DIR/scripts/command-guard/index.ts\" --hook"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  }
}
