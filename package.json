{
  "name": "nextjs-boilerplate",
  "version": "0.8.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "add:ui": "npm_config_ignore_workspace_root_check=true tsx src/components/scripts/add-shadcn.ts",
    "build": "tsx scripts/build",
    "bundle-budget": "tsx scripts/bundle-budget",
    "build-storybook": "APP_ENV=${APP_ENV:-local} storybook build",
    "check:architecture": "tsx scripts/architecture",
    "check:classes": "tsx src/components/scripts/check-classes.ts",
    "check:tokens": "tsx tokens/scripts/gen-tokens.ts --check",
    "check:ui": "tsx src/components/scripts/check-shadcn.ts",
    "design:bundle": "tsx scripts/design-bundle",
    "dev": "APP_ENV=${APP_ENV:-local} next dev",
    "fix": "biome check --fix",
    "format": "biome format --write",
    "gen": "tsx scripts/gen",
    "gen:tokens": "tsx tokens/scripts/gen-tokens.ts",
    "knip": "knip",
    "lint": "biome check",
    "lint:ci": "biome check --config-path=./biome.ci.jsonc --error-on-warnings && pnpm lint:eslint && pnpm check:architecture",
    "lint:eslint": "eslint .",
    "md-fix": "markdownlint-cli2 --fix",
    "md-lint": "markdownlint-cli2 && tsx scripts/mermaid-lint && tsx scripts/skill-lint",
    "portal:build": "pnpm portal:guides && pnpm portal:docs && pnpm --filter docs-viewer build",
    "portal:docs": "tsx scripts/portal/gen-docs-json.ts",
    "portal:guides": "tsx scripts/portal/gen-portal-docs.ts",
    "portal:preview": "pnpm portal:site && vite preview --outDir dist",
    "portal:site": "pnpm portal:build && tsx scripts/portal/build-site.ts",
    "render-mode": "tsx scripts/render-mode",
    "start": "next start",
    "storybook": "APP_ENV=${APP_ENV:-local} storybook dev -p 6006",
    "test": "vitest run --coverage --no-cache",
    "test:cached": "vitest run",
    "test:light": "vitest run --coverage --no-cache --maxWorkers=4",
    "test:scripts": "vitest run --config vitest.scripts.config.ts --coverage --no-cache",
    "test:scripts:cached": "vitest run --config vitest.scripts.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "5.5.7",
    "@next/third-parties": "16.3.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
