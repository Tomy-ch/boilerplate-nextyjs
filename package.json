    "shadcn": "4.15.0",
    "smol-toml": "1.8.0",
    "storybook": "10.5.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
