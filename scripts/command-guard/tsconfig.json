{
  // `allowImportingTsExtensions` を root へ動かさないこと。orval がそれを読み、生成物まで
  // 拡張子付きの import を吐く。ここが要るのは、この道具だけ Node の型ストリップで直接
  // 実行するため（[README](../README.md)）。
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    // 親を離れると既定の typeRoots の起点も動く。
    "types": ["node"]
  },
  // `exclude` も継承されるので上書きする。親はこのディレクトリを除いている。
  "include": ["**/*.ts"],
  "exclude": []
}
